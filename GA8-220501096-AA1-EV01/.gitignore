.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.pidb
*.cache
*.ncb
*.opendb
*.opensdf
*.VC.db
*.VC.VC.opendb

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code
.vscode/

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# SECRETOS — NUNCA subir credenciales al repositorio
# =============================================================================
.env
.env.local
.env.*.local
*.env
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
secrets.json
**/secrets.json

