# =============================================================================
# NotePlusTaller.API — Variables de entorno
# =============================================================================
# Copie este archivo como .env y complete los valores reales.
# NUNCA suba el archivo .env al repositorio (ya está en .gitignore).
# =============================================================================

# Cadena de conexión a Supabase (PostgreSQL via Npgsql)
# Formato: Host=db.{PROJECT_REF}.supabase.co;Database=postgres;Username=postgres.{PROJECT_REF};Password={PASSWORD};SSL Mode=Require;Trust Server Certificate=true
#
# Dónde obtener estos valores:
#   1. Abra https://supabase.com/dashboard y seleccione el proyecto "noteplus-taller"
#   2. Vaya a Project Settings → Database → Connection string → URI
#   3. YOUR_PROJECT_REF: la parte entre "db." y ".supabase.co" en el host
#   4. YOUR_PASSWORD:    la contraseña de la base de datos (Settings → Database → Database password)
#
SUPABASE_CONNECTION_STRING=Host=db.YOUR_PROJECT_REF.supabase.co;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
