@using NotePlusTaller.Web.Models

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Nacionalidad <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.IDNacionalidad" class="form-select">
            <option value="0">-- Seleccione --</option>
            @foreach (var n in Nacionalidades)
            {
                <option value="@n.IDNacionalidad">@n.NombreNacionalidad</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model.IDNacionalidad" class="text-danger small" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Tipo de documento <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.TipoDocumento" class="form-select">
            <option value="">-- Tipo --</option>
            <option value="CC">CC — Cédula ciudadanía</option>
            <option value="TI">TI — Tarjeta identidad</option>
            <option value="CE">CE — Cédula extranjería</option>
            <option value="PP">PP — Pasaporte</option>
            <option value="NIT">NIT</option>
        </InputSelect>
        <ValidationMessage For="() => Model.TipoDocumento" class="text-danger small" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Número de documento <span class="text-danger">*</span></label>
        <InputText @bind-Value="Model.NumeroDocumento" class="form-control" placeholder="1234567890" />
        <ValidationMessage For="() => Model.NumeroDocumento" class="text-danger small" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Primer nombre <span class="text-danger">*</span></label>
        <InputText @bind-Value="Model.PrimerNombre" class="form-control" />
        <ValidationMessage For="() => Model.PrimerNombre" class="text-danger small" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Segundo nombre</label>
        <InputText @bind-Value="Model.SegundoNombre" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Primer apellido <span class="text-danger">*</span></label>
        <InputText @bind-Value="Model.PrimerApellido" class="form-control" />
        <ValidationMessage For="() => Model.PrimerApellido" class="text-danger small" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Segundo apellido</label>
        <InputText @bind-Value="Model.SegundoApellido" class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Fecha de nacimiento <span class="text-danger">*</span></label>
        <InputDate @bind-Value="Model.FechaNacimiento" class="form-control" />
        <ValidationMessage For="() => Model.FechaNacimiento" class="text-danger small" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Correo electrónico <span class="text-danger">*</span></label>
        <InputText @bind-Value="Model.CorreoElectronico" class="form-control" placeholder="correo@ejemplo.com" />
        <ValidationMessage For="() => Model.CorreoElectronico" class="text-danger small" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Celular</label>
        <InputText @bind-Value="Model.Celular" class="form-control" placeholder="3001234567" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Teléfono fijo</label>
        <InputText @bind-Value="Model.TelefonoFijo" class="form-control" placeholder="6011234567" />
    </div>

    <div class="col-md-8">
        <label class="form-label">Dirección de residencia</label>
        <InputText @bind-Value="Model.DireccionResidencia" class="form-control" placeholder="Calle 1 # 2-3, Ciudad" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CrearPersonaModel Model { get; set; } = null!;
    [Parameter, EditorRequired] public List<NacionalidadModel> Nacionalidades { get; set; } = [];
}
