@page "/personas/crear"
@attribute [Authorize]
@using NotePlusTaller.Web.Shared
@inject ApiPersonaService PersonaService
@inject ApiNacionalidadService NacionalidadService
@inject NavigationManager Nav

<PageTitle>Nueva persona</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Nueva persona</h4>
    <a href="/personas" class="btn btn-sm btn-outline-secondary">Volver</a>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <EditForm Model="model" OnValidSubmit="HandleCrear">
                <DataAnnotationsValidator />
                <FormPersona Model="model" Nacionalidades="nacionalidades" />

                @if (error is not null)
                {
                    <div class="alert alert-danger py-2 small">@error</div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@enviando">
                        @(enviando ? "Guardando..." : "Guardar")
                    </button>
                    <a href="/personas" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private readonly CrearPersonaModel model = new();
    private List<NacionalidadModel> nacionalidades = [];
    private string? error;
    private bool enviando;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        nacionalidades = await NacionalidadService.GetAll();
        cargando = false;
    }

    private async Task HandleCrear()
    {
        enviando = true;
        error = null;
        var (resultado, err) = await PersonaService.Crear(model);
        enviando = false;
        if (resultado is not null)
            Nav.NavigateTo($"/personas/detalle/{resultado.IDPersona}");
        else
            error = err;
    }
}
