@page "/personas"
@attribute [Authorize]
@inject ApiPersonaService PersonaService
@inject NavigationManager Nav

<PageTitle>Personas</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Personas</h4>
    <a href="/personas/crear" class="btn btn-primary btn-sm">+ Nueva persona</a>
</div>

<div class="mb-3">
    <input class="form-control form-control-sm" style="max-width: 320px;"
           placeholder="Buscar por nombre o documento..."
           @bind="busqueda" @bind:event="oninput" />
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Cargando personas...</p>
    </div>
}
else if (!personas.Any())
{
    <div class="alert alert-info">No hay personas registradas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Nombre completo</th>
                    <th>Documento</th>
                    <th>Correo</th>
                    <th>Nacionalidad</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in PersonasFiltradas)
                {
                    <tr>
                        <td>@p.IDPersona</td>
                        <td>@p.NombreCompleto</td>
                        <td>
                            <span class="badge bg-secondary">@p.TipoDocumento</span>
                            @p.NumeroDocumento
                        </td>
                        <td>@p.CorreoElectronico</td>
                        <td>@p.NombreNacionalidad</td>
                        <td>
                            @if (p.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a href="/personas/detalle/@p.IDPersona" class="btn btn-sm btn-outline-primary me-1">Ver</a>
                            <a href="/personas/editar/@p.IDPersona" class="btn btn-sm btn-outline-secondary me-1">Editar</a>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => ConfirmarEliminar(p.IDPersona, p.NombreCompleto)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <small class="text-muted">@PersonasFiltradas.Count() de @personas.Count personas</small>
}

@if (error is not null)
{
    <div class="alert alert-danger mt-3 py-2 small">@error</div>
}

@if (confirmarId.HasValue)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,.4)">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Confirmar eliminación</h6>
                </div>
                <div class="modal-body">
                    <p class="small">¿Desactivar a <strong>@confirmarNombre</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button class="btn btn-sm btn-danger" @onclick="EjecutarEliminar" disabled="@eliminando">
                        @(eliminando ? "..." : "Confirmar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PersonaModel> personas = [];
    private string busqueda = string.Empty;
    private bool cargando = true;
    private string? error;
    private int? confirmarId;
    private string? confirmarNombre;
    private bool eliminando;

    private IEnumerable<PersonaModel> PersonasFiltradas =>
        string.IsNullOrWhiteSpace(busqueda)
            ? personas
            : personas.Where(p =>
                p.NombreCompleto.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
                p.NumeroDocumento.Contains(busqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        personas = await PersonaService.GetAll();
        cargando = false;
    }

    private void ConfirmarEliminar(int id, string nombre)
    {
        confirmarId = id;
        confirmarNombre = nombre;
        error = null;
    }

    private void CancelarEliminar()
    {
        confirmarId = null;
        confirmarNombre = null;
    }

    private async Task EjecutarEliminar()
    {
        if (!confirmarId.HasValue) return;
        eliminando = true;
        var (exito, err) = await PersonaService.Eliminar(confirmarId.Value);
        eliminando = false;
        confirmarId = null;
        confirmarNombre = null;
        if (exito)
            personas = await PersonaService.GetAll();
        else
            error = err;
    }
}
