@page "/registro"
@layout EmptyLayout
@inject AuthService AuthService
@inject ApiRolService RolService
@inject NavigationManager Nav

<PageTitle>Crear cuenta</PageTitle>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white py-3">
        <h5 class="mb-0 text-center">NotePlus Taller</h5>
    </div>
    <div class="card-body p-4">
        <h6 class="mb-3">Crear cuenta</h6>

        @if (cargando)
        {
            <div class="text-center py-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span class="ms-2">Cargando...</span>
            </div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="HandleRegistro">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">ID de Persona <span class="text-danger">*</span></label>
                    <InputNumber @bind-Value="model.IDPersona" class="form-control" placeholder="ID de la persona" />
                    <ValidationMessage For="() => model.IDPersona" class="text-danger small" />
                    <div class="form-text">La persona debe existir en el sistema.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Rol <span class="text-danger">*</span></label>
                    <InputSelect @bind-Value="model.IDRol" class="form-select">
                        <option value="0">-- Seleccione un rol --</option>
                        @foreach (var rol in roles)
                        {
                            <option value="@rol.IDRol">@rol.NombreRol</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => model.IDRol" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre de usuario <span class="text-danger">*</span></label>
                    <InputText @bind-Value="model.NombreUsuario" class="form-control" placeholder="usuario123" />
                    <ValidationMessage For="() => model.NombreUsuario" class="text-danger small" />
                </div>

                <div class="mb-4">
                    <label class="form-label">Contraseña <span class="text-danger">*</span></label>
                    <input type="password" @bind="model.Contrasena" class="form-control" placeholder="Mínimo 8 caracteres" />
                    <ValidationMessage For="() => model.Contrasena" class="text-danger small" />
                </div>

                @if (error is not null)
                {
                    <div class="alert alert-danger py-2 small">@error</div>
                }
                @if (exitoso)
                {
                    <div class="alert alert-success py-2 small">
                        Cuenta creada exitosamente. <a href="/login">Iniciar sesión</a>
                    </div>
                }

                <button type="submit" class="btn btn-primary w-100" disabled="@enviando">
                    @(enviando ? "Creando cuenta..." : "Crear cuenta")
                </button>
            </EditForm>
        }
    </div>
    <div class="card-footer text-center py-3">
        <small>
            ¿Ya tiene cuenta?
            <a href="/login">Iniciar sesión</a>
        </small>
    </div>
</div>

@code {
    private readonly RegistroModel model = new();
    private List<RolModel> roles = [];
    private string? error;
    private bool enviando;
    private bool cargando = true;
    private bool exitoso;

    protected override async Task OnInitializedAsync()
    {
        roles = await RolService.GetAll();
        cargando = false;
    }

    private async Task HandleRegistro()
    {
        enviando = true;
        error = null;
        exitoso = false;

        var (exito, err) = await AuthService.Registro(model);
        if (exito)
            exitoso = true;
        else
            error = err;

        enviando = false;
    }
}
