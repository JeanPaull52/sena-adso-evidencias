@page "/registro"
@layout EmptyLayout
@inject AuthService AuthService
@inject ApiRolService RolService
@inject ApiNacionalidadService NacionalidadService
@inject ApiPersonaService PersonaService
@inject NavigationManager Nav

<PageTitle>Crear cuenta</PageTitle>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white py-3">
        <h5 class="mb-0 text-center">NotePlus Taller</h5>
    </div>
    <div class="card-body p-4">
        <h6 class="mb-3">Crear cuenta</h6>

        @if (cargando)
        {
            <div class="text-center py-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span class="ms-2">Cargando...</span>
            </div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="HandleRegistro">
                <DataAnnotationsValidator />

                <p class="text-muted small fw-semibold mb-2">Datos personales</p>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label form-label-sm">Primer nombre <span class="text-danger">*</span></label>
                        <InputText @bind-Value="model.PrimerNombre" class="form-control form-control-sm" placeholder="Juan" />
                        <ValidationMessage For="() => model.PrimerNombre" class="text-danger small" />
                    </div>
                    <div class="col-6">
                        <label class="form-label form-label-sm">Primer apellido <span class="text-danger">*</span></label>
                        <InputText @bind-Value="model.PrimerApellido" class="form-control form-control-sm" placeholder="Pérez" />
                        <ValidationMessage For="() => model.PrimerApellido" class="text-danger small" />
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-5">
                        <label class="form-label form-label-sm">Tipo doc. <span class="text-danger">*</span></label>
                        <InputSelect @bind-Value="model.TipoDocumento" class="form-select form-select-sm">
                            <option value="">-- Tipo --</option>
                            <option value="CC">CC</option>
                            <option value="CE">CE</option>
                            <option value="Pasaporte">Pasaporte</option>
                        </InputSelect>
                        <ValidationMessage For="() => model.TipoDocumento" class="text-danger small" />
                    </div>
                    <div class="col-7">
                        <label class="form-label form-label-sm">Número de documento <span class="text-danger">*</span></label>
                        <InputText @bind-Value="model.NumeroDocumento" class="form-control form-control-sm" placeholder="1000000001" />
                        <ValidationMessage For="() => model.NumeroDocumento" class="text-danger small" />
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label form-label-sm">Celular <span class="text-danger">*</span></label>
                        <InputText @bind-Value="model.Celular" class="form-control form-control-sm" placeholder="3001234567" />
                        <ValidationMessage For="() => model.Celular" class="text-danger small" />
                    </div>
                    <div class="col-6">
                        <label class="form-label form-label-sm">Correo electrónico <span class="text-danger">*</span></label>
                        <InputText @bind-Value="model.CorreoElectronico" class="form-control form-control-sm" placeholder="correo@ejemplo.com" />
                        <ValidationMessage For="() => model.CorreoElectronico" class="text-danger small" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label form-label-sm">Nacionalidad <span class="text-danger">*</span></label>
                    <InputSelect @bind-Value="model.IDNacionalidad" class="form-select form-select-sm">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var nac in nacionalidades)
                        {
                            <option value="@nac.IDNacionalidad">@nac.NombreNacionalidad</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => model.IDNacionalidad" class="text-danger small" />
                </div>

                <hr class="my-3" />
                <p class="text-muted small fw-semibold mb-2">Datos de la cuenta</p>

                <div class="mb-2">
                    <label class="form-label form-label-sm">Rol <span class="text-danger">*</span></label>
                    <InputSelect @bind-Value="model.IDRol" class="form-select form-select-sm" disabled="@(roles.Count == 1)">
                        <option value="0">-- Seleccione un rol --</option>
                        @foreach (var rol in roles)
                        {
                            <option value="@rol.IDRol">@rol.NombreRol</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => model.IDRol" class="text-danger small" />
                </div>

                <div class="mb-2">
                    <label class="form-label form-label-sm">Nombre de usuario <span class="text-danger">*</span></label>
                    <InputText @bind-Value="model.NombreUsuario" class="form-control form-control-sm" placeholder="usuario123" />
                    <ValidationMessage For="() => model.NombreUsuario" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label form-label-sm">Contraseña <span class="text-danger">*</span></label>
                    <input type="password" @bind="model.Contrasena" class="form-control form-control-sm" placeholder="Mínimo 8 caracteres" />
                    <ValidationMessage For="() => model.Contrasena" class="text-danger small" />
                </div>

                @if (error is not null)
                {
                    <div class="alert alert-danger py-2 small">@error</div>
                }
                @if (exitoso)
                {
                    <div class="alert alert-success py-2 small">
                        Cuenta creada exitosamente. <a href="/login">Iniciar sesión</a>
                    </div>
                }

                <button type="submit" class="btn btn-primary w-100 btn-sm" disabled="@enviando">
                    @(enviando ? "Creando cuenta..." : "Crear cuenta")
                </button>
            </EditForm>
        }
    </div>
    <div class="card-footer text-center py-3">
        <small>
            ¿Ya tiene cuenta?
            <a href="/login">Iniciar sesión</a>
        </small>
    </div>
</div>

@code {
    private readonly RegistroCompletoModel model = new();
    private List<RolModel> roles = [];
    private List<NacionalidadModel> nacionalidades = [];
    private string? error;
    private bool enviando;
    private bool cargando = true;
    private bool exitoso;

    protected override async Task OnInitializedAsync()
    {
        var rolTask = RolService.GetAll();
        var nacTask = NacionalidadService.GetAll();
        await Task.WhenAll(rolTask, nacTask);

        roles = rolTask.Result;
        nacionalidades = nacTask.Result;

        if (roles.Count == 1)
            model.IDRol = roles[0].IDRol;

        cargando = false;
    }

    private async Task HandleRegistro()
    {
        enviando = true;
        error = null;
        exitoso = false;

        var personaDto = new CrearPersonaModel
        {
            IDNacionalidad    = model.IDNacionalidad,
            TipoDocumento     = model.TipoDocumento,
            NumeroDocumento   = model.NumeroDocumento,
            PrimerNombre      = model.PrimerNombre,
            PrimerApellido    = model.PrimerApellido,
            Celular           = model.Celular,
            CorreoElectronico = model.CorreoElectronico,
            FechaNacimiento   = DateOnly.FromDateTime(DateTime.Today.AddYears(-18))
        };

        var (persona, personaError) = await PersonaService.Crear(personaDto);
        if (persona is null)
        {
            error = personaError ?? "Error al crear la persona.";
            enviando = false;
            return;
        }

        var registroDto = new RegistroModel
        {
            IDPersona     = persona.IDPersona,
            IDRol         = model.IDRol,
            NombreUsuario = model.NombreUsuario,
            Contrasena    = model.Contrasena
        };

        var (exito, err) = await AuthService.Registro(registroDto);
        if (exito)
            exitoso = true;
        else
            error = err;

        enviando = false;
    }
}
